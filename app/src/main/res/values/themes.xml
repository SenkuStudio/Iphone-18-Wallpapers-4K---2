<resources>
    <style name="Theme.Wallpaper" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Wallpaper.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/logoapp</item>
        <item name="windowSplashScreenBackground">@color/spiderman_splash_icon_bg</item>
        <item name="postSplashScreenTheme">@style/Theme.Wallpaper</item>
    </style>
</resources>
